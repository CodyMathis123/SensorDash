<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>WinExe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SensorDash</AssemblyName>
    <Version>0.2.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <PackageReference Include="System.IO.Pipes.AccessControl" Version="5.0.0" />
    <EmbeddedResource Include="wwwroot/index.html" LogicalName="SensorDash.Web.index.html" />
    <EmbeddedResource Include="wwwroot/app.js" LogicalName="SensorDash.Web.app.js" />
    <EmbeddedResource Include="wwwroot/style.css" LogicalName="SensorDash.Web.style.css" />
  </ItemGroup>
</Project>
