<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SensorDash</AssemblyName>
    <Version>$(SensorDashVersion)</Version>
    <ApplicationIcon>Assets\SensorDash.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Explicit opt-in memory experiments only; baseline release is unchanged. -->
    <ServerGarbageCollection Condition="'$(SensorDashGcMode)' == 'workstation'">false</ServerGarbageCollection>
    <ServerGarbageCollection Condition="'$(SensorDashGcMode)' == 'server'">true</ServerGarbageCollection>
  </PropertyGroup>
  <Target Name="GenerateSensorDashApplicationIcon" BeforeTargets="PrepareForBuild">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\Generate-SensorDashIcon.ps1&quot; -OutputPath &quot;$(MSBuildProjectDirectory)\Assets\SensorDash.ico&quot;" />
  </Target>
  <ItemGroup Condition="'$(SensorDashGcConserveMemory)' != ''">
    <!-- Valid values: 0-9; never set by normal release builds. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="$(SensorDashGcConserveMemory)" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="TrayIconFactory.cs" />
    <Compile Remove="TraySensorIcon.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Assets\SensorDash.ico" CopyToPublishDirectory="Always" TargetPath="SensorDash.ico" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.14" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <EmbeddedResource Include="../../presets/cooling/*.json" LogicalName="SensorDash.CoolingPresets.%(Filename)%(Extension)" />
    <EmbeddedResource Include="wwwroot/index.html" LogicalName="SensorDash.Web.index.html" />
    <EmbeddedResource Include="wwwroot/driver-status.js" LogicalName="SensorDash.Web.driver-status.js" />
    <EmbeddedResource Include="wwwroot/app.js" LogicalName="SensorDash.Web.app.js" />
    <EmbeddedResource Include="wwwroot/workspace.js" LogicalName="SensorDash.Web.workspace.js" />
    <EmbeddedResource Include="wwwroot/fan-commissioning.js" LogicalName="SensorDash.Web.fan-commissioning.js" />
    <EmbeddedResource Include="wwwroot/fan-control-ux.js" LogicalName="SensorDash.Web.fan-control-ux.js" />
    <EmbeddedResource Include="wwwroot/fan-control-debug.js" LogicalName="SensorDash.Web.fan-control-debug.js" />
    <EmbeddedResource Include="wwwroot/workspace-locks.js" LogicalName="SensorDash.Web.workspace-locks.js" />
    <EmbeddedResource Include="wwwroot/fan-feedback.js" LogicalName="SensorDash.Web.fan-feedback.js" />
    <EmbeddedResource Include="wwwroot/cooling-insights.js" LogicalName="SensorDash.Web.cooling-insights.js" />
    <EmbeddedResource Include="wwwroot/cooling-electrical.js" LogicalName="SensorDash.Web.cooling-electrical.js" />
    <EmbeddedResource Include="wwwroot/style.css" LogicalName="SensorDash.Web.style.css" />
  </ItemGroup>
</Project>
