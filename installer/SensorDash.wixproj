<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <OutputName>SensorDash-Setup-0.8.1-x64</OutputName>
    <DefineConstants>PublishDir=$(MSBuildThisFileDirectory)..\dist</DefineConstants>
    <OutputPath>$(MSBuildThisFileDirectory)..\installer-output\</OutputPath>
  </PropertyGroup>
</Project>
