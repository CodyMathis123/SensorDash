<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <OutputName>SensorDash-Setup-$(SensorDashVersion)-x64</OutputName>
    <DefineConstants>SensorDashVersion=$(SensorDashVersion);SensorDashProductCode=$(SensorDashProductCode);SensorDashUpgradeCode=$(SensorDashUpgradeCode);PublishDir=$(MSBuildThisFileDirectory)..\dist</DefineConstants>
    <OutputPath>$(MSBuildThisFileDirectory)..\installer-output\</OutputPath>
  </PropertyGroup>
</Project>
