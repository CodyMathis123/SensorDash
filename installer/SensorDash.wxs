<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="SensorDash"
           Manufacturer="CodyMathis" Version="$(var.SensorDashVersion)" ProductCode="$(var.SensorDashProductCode)" Scope="perMachine"
           UpgradeCode="$(var.SensorDashUpgradeCode)">
    <SummaryInformation Description="SensorDash local hardware-monitoring dashboard and Windows collector service" />
    <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="A newer version of SensorDash is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <!-- PawnIO is a shared, separately serviced driver. The collector reports
         missing/outdated/inaccessible support in the UI; never remove it here. -->
    <Property Id="ARPCOMMENTS" Value="Local hardware telemetry. Some CPU and motherboard sensors need the separately installed PawnIO driver; check Hardware driver in SensorDash Settings." />
    <!-- Ask the desktop to exit in the immediate phase (before the file
         replacement); the elevated deferred phase still runs AFTER
         StopServices and can terminate only SensorDash.exe if it does not
         respond within ten seconds. The collector service is handled by
         ServiceControl, not by forcibly killing that service. -->
    <!-- Close both the legacy WinForms desktop on upgrade and the new native
         user-session tray. The collector is stopped by ServiceControl only. -->
    <util:CloseApplication Id="CloseSensorDash" Target="SensorDash.exe"
                           CloseMessage="yes" EndSessionMessage="yes"
                           ElevatedCloseMessage="yes" ElevatedEndSessionMessage="yes"
                           PromptToContinue="no" Timeout="10"
                           RebootPrompt="no" TerminateProcess="0" />
    <util:CloseApplication Id="CloseSensorDashTray" Target="SensorDash.Tray.exe"
                           CloseMessage="yes" EndSessionMessage="yes"
                           ElevatedCloseMessage="yes" ElevatedEndSessionMessage="yes"
                           PromptToContinue="no" Timeout="10"
                           RebootPrompt="no" TerminateProcess="0" />
    <InstallExecuteSequence>
      <Custom Action="override Wix4CloseApplications_$(sys.BUILDARCHSHORT)" After="StopServices" />
    </InstallExecuteSequence>
    <!-- Advertised EXE shortcuts require icon data in PE format with an .exe Icon ID.
         The tiny build-only carrier contains the same icon as SensorDash.exe. -->
    <Icon Id="SensorDashShortcutIcon.exe" SourceFile="$(var.PublishDir)\..\installer-assets\SensorDashShortcutIcon.exe" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="SensorDash">
        <Component Id="SensorDashExecutable" Guid="*">
          <File Id="SensorDashExe" Source="$(var.PublishDir)\SensorDash.exe" KeyPath="yes">
            <Shortcut Id="OpenSensorDash" Directory="ProgramMenuFolder" Name="SensorDash"
                      Description="Open SensorDash hardware dashboard" Advertise="yes" Icon="SensorDashShortcutIcon.exe" WorkingDirectory="INSTALLFOLDER" />
          </File>
          <ServiceInstall Id="InstallSensorDashCollector" Name="SensorDashCollector"
                          DisplayName="SensorDash Collector"
                          Description="Hardware telemetry, local web dashboard and validated cooling control."
                          Type="ownProcess" Start="auto" ErrorControl="normal"
                          Arguments="--collector" Vital="yes" />
          <ServiceControl Id="ControlSensorDashCollector" Name="SensorDashCollector"
                          Start="install" Stop="both" Remove="uninstall" Wait="yes" />
        </Component>
        <Component Id="NativeTrayExecutable" Guid="*">
          <File Id="NativeTrayExe" Source="$(var.PublishDir)\SensorDash.Tray.exe" KeyPath="yes">
            <Shortcut Id="OpenSensorDashTray" Directory="ProgramMenuFolder" Name="SensorDash Tray"
                      Description="Launch SensorDash notification icons" Advertise="yes"
                      Icon="SensorDashShortcutIcon.exe" WorkingDirectory="INSTALLFOLDER" />
          </File>
        </Component>
        <Component Id="TrayAutoStart" Guid="*">
          <RegistryValue Root="HKLM"
                         Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run"
                         Name="SensorDash"
                         Type="string"
                         Value="&quot;[INSTALLFOLDER]SensorDash.Tray.exe&quot;"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Complete" Title="SensorDash" Level="1">
      <ComponentRef Id="SensorDashExecutable" />
      <ComponentRef Id="NativeTrayExecutable" />
      <ComponentRef Id="TrayAutoStart" />
    </Feature>
  </Package>
</Wix>
