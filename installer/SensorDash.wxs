<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Id="CodyMathis.SensorDash" Name="SensorDash"
           Manufacturer="CodyMathis" Version="0.2.0" Scope="perMachine"
           UpgradeCode="6D8F4B3B-3780-4A7C-AD1D-58343B1AD2CE">
    <SummaryInformation Description="SensorDash local hardware-monitoring dashboard and Windows collector service" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of SensorDash is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="SensorDash">
        <Component Id="SensorDashExecutable" Guid="*">
          <File Id="SensorDashExe" Source="$(var.PublishDir)\SensorDash.exe" KeyPath="yes" />
          <ServiceInstall Id="InstallSensorDashCollector" Name="SensorDashCollector"
                          DisplayName="SensorDash Collector"
                          Description="Elevated read-only hardware telemetry collector; local named-pipe IPC only."
                          Type="ownProcess" Start="auto" ErrorControl="normal"
                          Arguments="--collector" Vital="yes" />
          <ServiceControl Id="ControlSensorDashCollector" Name="SensorDashCollector"
                          Start="install" Stop="both" Remove="uninstall" Wait="yes" />
        </Component>
        <Component Id="TrayAutoStart" Guid="*">
          <RegistryValue Root="HKLM"
                         Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run"
                         Name="SensorDash"
                         Type="string"
                         Value="&quot;[INSTALLFOLDER]SensorDash.exe&quot; --desktop --no-browser"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="SensorDashPrograms" Name="SensorDash">
        <Component Id="ShortcutComponent" Guid="*">
          <Shortcut Id="OpenSensorDash" Name="SensorDash" Description="Open SensorDash hardware dashboard"
                    Target="[INSTALLFOLDER]SensorDash.exe" Arguments="--desktop"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveProgramsFolder" On="uninstall" />
          <RegistryValue Root="HKLM" Key="SOFTWARE\SensorDash"
                         Name="Installed" Type="integer" Value="1" KeyPath="yes"/>
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Complete" Title="SensorDash" Level="1" Absent="disallow">
      <ComponentRef Id="SensorDashExecutable" />
      <ComponentRef Id="TrayAutoStart" />
      <ComponentRef Id="ShortcutComponent" />
    </Feature>
  </Package>
</Wix>
